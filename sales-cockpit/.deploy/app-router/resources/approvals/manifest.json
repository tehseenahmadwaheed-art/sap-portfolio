{
  "_version": "1.59.0",
  "sap.app": {
    "id": "approvals",
    "type": "application",
    "title": "Order Approvals",
    "applicationVersion": { "version": "1.0.0" },
    "dataSources": {
      "mainService": { "uri": "/odata/v4/approval/", "type": "OData", "settings": { "odataVersion": "4.0" } }
    }
  },
  "sap.ui": { "technology": "UI5" },
  "sap.ui5": {
    "dependencies": { "minUI5Version": "1.120.0", "libs": { "sap.m": {}, "sap.ui.core": {}, "sap.fe.templates": {} } },
    "models": {
      "": { "dataSource": "mainService", "preload": true, "settings": { "operationMode": "Server", "autoExpandSelect": true, "earlyRequests": true } }
    },
    "routing": {
      "routes": [
        { "pattern": ":?query:", "name": "OrderApprovalsList", "target": "OrderApprovalsList" },
        { "pattern": "OrderApprovals({key}):?query:", "name": "OrderApprovalsObjectPage", "target": "OrderApprovalsObjectPage" }
      ],
      "targets": {
        "OrderApprovalsList": {
          "type": "Component", "id": "OrderApprovalsList", "name": "sap.fe.templates.ListReport",
          "options": { "settings": { "contextPath": "/OrderApprovals", "variantManagement": "Page",
            "navigation": { "OrderApprovals": { "detail": { "route": "OrderApprovalsObjectPage" } } } } }
        },
        "OrderApprovalsObjectPage": {
          "type": "Component", "id": "OrderApprovalsObjectPage", "name": "sap.fe.templates.ObjectPage",
          "options": { "settings": { "contextPath": "/OrderApprovals" } }
        }
      }
    }
  }
}